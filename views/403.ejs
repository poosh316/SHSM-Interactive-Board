<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>403 Forbidden</h1>
    <a href="/home"><button>Go to home page</button></a>
    <p>Delete route to 403.ejs in routes/root.js when done</p>
    <p>parameters need to be sent in somehow</p>
    <div>
        Session expires in: <span id="time-remaining" data-seconds="<%= secondsRemaining %>">
            Loading...
        </span>
    </div>


    <script>
        const timeSpan = document.getElementById('time-remaining');
  
        if (timeSpan) {
            let timeLeft = parseInt(timeSpan.getAttribute('data-seconds'), 10);

            const interval = setInterval(() => {
            if (timeLeft <= 0) {
                clearInterval(interval);
                timeSpan.textContent = "Session Expired";

                window.location.href = '/error.html'; 
                
                //// Dispatch custom HTMX event to handle auto-logout
                // document.body.dispatchEvent(new CustomEvent('session-expired'));
                // return;
            }

            // Calculate minutes and seconds
            const minutes = Math.floor(timeLeft / 60);
            const seconds = timeLeft % 60;
            
            // Display formatted time (e.g., 14:05)
            timeSpan.textContent = `${minutes}:${seconds.toString().padStart(2, '0')}`;
            
            timeLeft--;
            }, 1000);
        }
    </script>
</body>
</html>
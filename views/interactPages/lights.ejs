<!DOCTYPE = html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>lights</title>

	<link href="/styles.css" rel="stylesheet" />
</head>

<body>
    <div class="navBar">
        <ul>
            <li><a id="logo" href="/home"><img src="/images/SHSMLogo.png" alt="SHSM" /></a></li>
            <li><a href="/home">Home</a></li>
            <li><a href="/about">About</a></li>
            <li class="dropdown">
                <a class="current" href="javascript:void(0)" class="dropbtn">Interact</a>
                <div class="dropdownList">
                    <a href="/int/lights">Lights</a>
                    <a href="/int/drone">Drone</a>
                </div>
            </li>
            <li><a id="signup" href="/signup">Sign Up</a></li>
        </ul>
    </div>

    <br>
    
    <div class="disclaimer">
        <h4>
        <div>
            Session expires in: <span id="time-remaining" data-seconds="<%= secondsRemaining %>">
                Loading...
            </span>
        </div>
        </h4>
    </div>
    <p>Drag each slider to the right right to increase the amount of its colour, and to the left to decrease it.</p>
    <p>When you have your desired colour, press the "Set Colour" button at the bottom to change the lights on the board to your colour!</p>


    <div style="display:grid; grid-auto-flow:column; gap:10px;">
        <span style="width:100%; margin:-1px;">
            <p>red</p>
            <input class="colourSlider" id="red" type="range" min="0" max="255" />
        
            <p>green</p>
            <input class="colourSlider" id="green" type="range" min="0" max="255" />

            <p>blue</p>
            <input class="colourSlider" id="blue" type="range" min="0" max="255" />
        </span>

        <span style="height:100%; margin:-1px; text-align:center;">
            <span id="sample"></span>
        </span>
    </div>

    <br>
    <br>

    <div style="width:100%; text-align:center;">
        <button id="submit">Set Colour</button>
    </div>


    <div id="auth-status-container">
        <% if (isAuthenticated) { %>
            <!-- Show this text if the cookie exists and JWT is valid -->
            <p>Welcome back, user!</p>
        <% } else { %>

            <script>
                const red = document.getElementById('red');
                const green = document.getElementById('green');
                const blue = document.getElementById('blue');
                const submit = document.getElementById('submit');

                red.style.backgroundColor = `rgb(101, 101, 101)`;
                red.inert = true;
                green.style.backgroundColor = `rgb(101, 101, 101)`;
                green.inert = true;
                blue.style.backgroundColor = `rgb(101, 101, 101)`;
                blue.inert = true;
                submit.className = "disabledBtn";
                submit.inert = true;
            </script>

            <p>Your session has expired. Scan the QR code again to resume.</p>
        <% } %>
    </div>


    <script src="../interact.js"></script>
    <script>
        const timeSpan = document.getElementById('time-remaining');
        if (timeSpan) {
            let timeLeft = parseInt(timeSpan.getAttribute('data-seconds'), 10);

            const interval = setInterval(() => {
            if (timeLeft <= 0) {
                clearInterval(interval);
                timeSpan.textContent = "Session Expired";

                // style button and sliders to look disabled.
                red.style.backgroundColor = `rgb(101, 101, 101)`;
                red.inert = true;
                green.style.backgroundColor = `rgb(101, 101, 101)`;
                green.inert = true;
                blue.style.backgroundColor = `rgb(101, 101, 101)`;
                blue.inert = true;
                submit.className = "disabledBtn";
                submit.inert = true;

                // Update the HTML content immediately without reloading
                document.getElementById('auth-status-container').innerHTML = 
                    `<p>Your session has expired. Scan the QR code again to resume.</p>`;

                return;
            }

            // Calculate minutes and seconds
            const minutes = Math.floor(timeLeft / 60);
            const seconds = timeLeft % 60;
            
            // Display formatted time (e.g., 14:05)
            timeSpan.textContent = `${minutes}:${seconds.toString().padStart(2, '0')}`;

            //alert popup
            if(timeLeft-1==0){
                alert("Time expired. Please scan the QR code again.");
            }
            
            timeLeft--;
            
            }, 1000);
        }
    </script>
</body>
</html>